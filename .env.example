# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string. Adjust user/host/port/password to your setup.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/catalog?schema=public"

# Public base URL of the storefront, used for metadata, canonical links and JSON-LD.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth - signing secret for sessions (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# MinIO / S3 compatible storage used for media uploads
S3_ENDPOINT="localhost"
S3_PORT="9000"
S3_USE_SSL="false"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="catalog-images"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_PUBLIC_URL="http://localhost:9000"